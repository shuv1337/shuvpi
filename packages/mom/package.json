{
	"name": "@shuv1337/shuvpi-mom",
	"version": "0.80.9",
	"description": "Slack bot that delegates messages to the shuvpi coding agent",
	"type": "module",
	"bin": {
		"mom": "dist/main.js"
	},
	"main": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"files": [
		"dist",
		"CHANGELOG.md"
	],
	"scripts": {
		"clean": "shx rm -rf dist",
		"build": "tsgo -p tsconfig.build.json && shx chmod +x dist/main.js",
		"dev": "tsgo -p tsconfig.build.json --watch --preserveWatchOutput",
		"prepublishOnly": "npm run clean && npm run build"
	},
	"dependencies": {
		"@anthropic-ai/sandbox-runtime": "0.0.26",
		"@shuv1337/shuvpi-agent-core": "^0.80.9",
		"@shuv1337/shuvpi-ai": "^0.80.9",
		"@shuv1337/shuvpi-coding-agent": "^0.80.9",
		"typebox": "1.1.38",
		"@slack/socket-mode": "2.0.7",
		"@slack/web-api": "7.16.0",
		"chalk": "5.6.2",
		"croner": "9.1.0",
		"diff": "8.0.4"
	},
	"devDependencies": {
		"@types/diff": "7.0.2",
		"@types/node": "22.19.19",
		"typescript": "5.9.3"
	},
	"keywords": [
		"slack",
		"bot",
		"ai",
		"agent"
	],
	"author": "Mario Zechner",
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/shuv1337/pi-mono.git",
		"directory": "packages/mom"
	},
	"engines": {
		"node": ">=20.0.0"
	}
}
