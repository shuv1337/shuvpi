{
	"name": "@shuv1337/shuvpi-coding-agent",
	"version": "1.0.0",
	"description": "Coding agent CLI with read, bash, edit, write tools and session management",
	"type": "module",
	"shuvpiConfig": {
		"configDir": ".shuvpi"
	},
	"bin": {
		"shuvpi": "dist/bundle/cli.js"
	},
	"main": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"import": "./dist/index.js"
		},
		"./rpc-entry": {
			"import": "./dist/bundle/rpc-entry.js"
		},
		"./client": {
			"source": "./src/client/index.ts"
		},
		"./experimental/plugin": {
			"source": "./src/experimental/plugin.ts"
		},
		"./extensions/head": {
			"types": "./dist/extensions/head/index.d.ts",
			"import": "./dist/extensions/head/index.js",
			"source": "./src/extensions/head/index.ts"
		},
		"./extensions/diff-renderer": {
			"types": "./dist/extensions/diff-renderer/index.d.ts",
			"import": "./dist/extensions/diff-renderer/index.js",
			"source": "./src/extensions/diff-renderer/index.ts"
		},
		"./extensions/questionnaire": {
			"types": "./dist/extensions/questionnaire/index.d.ts",
			"import": "./dist/extensions/questionnaire/index.js",
			"source": "./src/extensions/questionnaire/index.ts"
		},
		"./extensions/workflow": {
			"types": "./dist/extensions/workflow/index.d.ts",
			"import": "./dist/extensions/workflow/index.js",
			"source": "./src/extensions/workflow/index.ts"
		},
		"./extensions/incremental-workflow": {
			"types": "./dist/extensions/incremental-workflow/index.d.ts",
			"import": "./dist/extensions/incremental-workflow/index.js",
			"source": "./src/extensions/incremental-workflow/index.ts"
		},
		"./extensions/image-files": {
			"types": "./dist/extensions/image-files/index.d.ts",
			"import": "./dist/extensions/image-files/index.js",
			"source": "./src/extensions/image-files/index.ts"
		},
		"./extensions/open-in-editor": {
			"types": "./dist/extensions/open-in-editor/index.d.ts",
			"import": "./dist/extensions/open-in-editor/index.js",
			"source": "./src/extensions/open-in-editor/index.ts"
		},
		"./extensions/background-jobs": {
			"types": "./dist/extensions/background-jobs/index.d.ts",
			"import": "./dist/extensions/background-jobs/index.js",
			"source": "./src/extensions/background-jobs/index.ts"
		},
		"./extensions/skill-browser": {
			"types": "./dist/extensions/skill-browser/index.d.ts",
			"import": "./dist/extensions/skill-browser/index.js",
			"source": "./src/extensions/skill-browser/index.ts"
		},
		"./extensions/active-skills": {
			"types": "./dist/extensions/active-skills/index.d.ts",
			"import": "./dist/extensions/active-skills/index.js",
			"source": "./src/extensions/active-skills/index.ts"
		},
		"./extensions/fast-mode": {
			"types": "./dist/extensions/fast-mode/index.d.ts",
			"import": "./dist/extensions/fast-mode/index.js",
			"source": "./src/extensions/fast-mode/index.ts"
		},
		"./extensions/preferred-models": {
			"types": "./dist/extensions/preferred-models/index.d.ts",
			"import": "./dist/extensions/preferred-models/index.js",
			"source": "./src/extensions/preferred-models/index.ts"
		},
    "./extensions/powerline": {
      "types": "./dist/extensions/powerline/index.d.ts",
      "import": "./dist/extensions/powerline/index.js",
      "source": "./src/extensions/powerline/index.ts"
    },
    "./extensions/subagents": {
      "types": "./dist/extensions/subagents/index.d.ts",
      "import": "./dist/extensions/subagents/index.js",
      "source": "./src/extensions/subagents/index.ts"
    },
    "./extensions/subagents/claude": {
      "types": "./dist/extensions/subagents/claude.d.ts",
      "import": "./dist/extensions/subagents/claude.js",
      "source": "./src/extensions/subagents/claude.ts"
    },
    "./extensions/bash-mode": {
      "types": "./dist/extensions/bash-mode/index.d.ts",
      "import": "./dist/extensions/bash-mode/index.js",
      "source": "./src/extensions/bash-mode/index.ts"
    },
    "./extensions/prompt-history": {
      "types": "./dist/extensions/prompt-history/index.d.ts",
      "import": "./dist/extensions/prompt-history/index.js",
      "source": "./src/extensions/prompt-history/index.ts"
    }
	},
	"files": [
		"dist",
		"!dist/client",
		"!dist/experimental",
		"!dist/cli/experimental",
		"docs",
		"examples",
		"containerization.md",
		"CHANGELOG.md",
		"npm-shrinkwrap.json"
	],
	"scripts": {
		"clean": "shx rm -rf dist",
		"build": "npm run build:unbundled && node ../../scripts/build-coding-agent-bundle.mjs",
		"build:unbundled": "tsc -p tsconfig.build.json && shx chmod +x dist/cli.js dist/rpc-entry.js && npm run copy-assets",
		"build:binary": "npm --prefix ../tui run build && npm --prefix ../telemetry run build && npm --prefix ../ai run build && npm --prefix ../agent run build && npm --prefix ../protocol run build && npm --prefix ../client run build && npm run build && bun build --compile --no-compile-autoload-bunfig ./dist/bun/cli.js ./src/utils/image-resize-worker.ts ./src/extensions/codemode/worker.ts --outfile dist/shuvpi && npm run copy-binary-assets",
		"copy-assets": "shx mkdir -p dist/modes/interactive/theme && shx cp src/modes/interactive/theme/*.json dist/modes/interactive/theme/ && shx mkdir -p dist/modes/interactive/assets && shx cp src/modes/interactive/assets/*.png dist/modes/interactive/assets/ && shx mkdir -p dist/core/export-html/vendor && shx cp src/core/export-html/template.html src/core/export-html/template.css src/core/export-html/template.js dist/core/export-html/ && shx cp src/core/export-html/vendor/*.js dist/core/export-html/vendor/",
		"copy-binary-assets": "shx cp package.json dist/ && shx cp README.md dist/ && shx cp CHANGELOG.md dist/ && shx mkdir -p dist/theme && shx cp src/modes/interactive/theme/*.json dist/theme/ && shx mkdir -p dist/assets && shx cp src/modes/interactive/assets/*.png dist/assets/ && shx mkdir -p dist/export-html/vendor && shx cp src/core/export-html/template.html dist/export-html/ && shx cp src/core/export-html/vendor/*.js dist/export-html/vendor/ && shx cp -r docs dist/ && shx cp -r examples dist/ && shx cp ../../node_modules/@silvia-odwyer/photon-node/photon_rs_bg.wasm dist/",
		"test": "vitest --run",
		"shrinkwrap": "node ../../scripts/generate-coding-agent-shrinkwrap.mjs",
		"prepublishOnly": "npm run clean && npm run build && npm run shrinkwrap"
	},
	"dependencies": {
		"@shuv1337/shuvpi-chord": "^1.0.0",
		"@shuv1337/shuvpi-agent-core": "^1.0.0",
		"@shuv1337/shuvpi-ai": "^1.0.0",
		"@shuv1337/shuvpi-codemode": "^1.0.0",
		"@shuv1337/shuvpi-durable": "^1.0.0",
		"@shuv1337/shuvpi-mcp": "^1.0.0",
		"@shuv1337/shuvpi-tui": "^1.0.0",
		"@silvia-odwyer/photon-node": "0.3.4",
		"chalk": "6.0.0",
		"cross-spawn": "7.0.6",
		"diff": "8.0.4",
		"grok-mermaid": "0.2.3",
		"highlight.js": "10.7.3",
		"hosted-git-info": "9.0.3",
		"ignore": "7.0.8",
		"jiti": "2.7.0",
		"minimatch": "10.2.6",
		"proper-lockfile": "4.1.2",
		"quickjs-wasi": "3.6.2",
		"semver": "7.8.5",
		"typebox": "1.3.27",
		"undici": "8.10.2",
		"yaml": "2.9.0"
	},
	"overrides": {
		"protobufjs": "7.6.6"
	},
	"devDependencies": {
		"@shuv1337/shuvpi-client": "^1.0.0",
		"@shuv1337/shuvpi-protocol": "^1.0.0",
		"@shuv1337/shuvpi-server": "^1.0.0",
		"@types/cross-spawn": "6.0.6",
		"@types/hosted-git-info": "3.0.5",
		"@types/node": "22.19.19",
		"@types/proper-lockfile": "4.1.4",
		"@types/semver": "7.7.1",
		"marked": "18.0.11",
		"shx": "0.4.0",
		"vitest": "4.1.11"
	},
	"keywords": [
		"coding-agent",
		"ai",
		"llm",
		"cli",
		"tui",
		"agent"
	],
	"author": "Mario Zechner",
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/shuv1337/shuvpi.git",
		"directory": "packages/coding-agent"
	},
	"engines": {
		"node": ">=22.19.0"
	},
	"optionalDependencies": {
		"@anthropic-ai/claude-agent-sdk": "0.3.210"
	}
}
