{
	"extends": "../../tsconfig.base.json",
	"compilerOptions": {
		"module": "ESNext",
		"moduleResolution": "bundler",
		"lib": [
			"ES2022",
			"DOM",
			"DOM.Iterable"
		],
		"noEmit": true,
		"paths": {
			"@shuv1337/shuvpi-telemetry": [
				"../telemetry/src/index.ts"
			],
			"@shuv1337/shuvpi-telemetry/testing": [
				"../telemetry/src/testing/index.ts"
			],
			"@shuv1337/shuvpi-agent-core": [
				"../agent/src/index.ts"
			],
			"@shuv1337/shuvpi-ai": [
				"../ai/src/index.ts"
			],
			"@shuv1337/shuvpi-ai/*": [
				"../ai/src/*.ts",
				"../ai/src/providers/*.ts"
			],
			"@shuv1337/shuvpi-chord": [
				"../chord/src/index.ts"
			],
			"@shuv1337/shuvpi-chord/context": [
				"../chord/src/context/index.ts"
			],
			"@shuv1337/shuvpi-chord/delta": [
				"../chord/src/delta/index.ts"
			],
			"@shuv1337/shuvpi-chord/node": [
				"../chord/src/node.ts"
			],
			"@shuv1337/shuvpi-tui": [
				"../tui/src/index.ts"
			],
			"@shuv1337/shuvpi-ai/compat": [
				"../ai/src/compat.ts"
			]
		}
	},
	"include": [
		"src/**/*"
	]
}
