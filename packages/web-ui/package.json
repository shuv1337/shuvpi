{
	"name": "@shuv1337/shuvpi-web-ui",
	"version": "0.84.2",
	"description": "Reusable web UI components for AI chat interfaces powered by @shuv1337/shuvpi-ai",
	"type": "module",
	"main": "dist/index.js",
	"types": "dist/index.d.ts",
	"exports": {
		".": "./dist/index.js",
		"./app.css": "./dist/app.css",
		"./components/*": "./dist/components/*",
		"./sandbox/*": "./dist/components/sandbox/*",
		"./storage/*": "./dist/storage/*"
	},
	"files": [
		"dist",
		"README.md",
		"CHANGELOG.md"
	],
	"scripts": {
		"clean": "shx rm -rf dist",
		"build": "tsc -p tsconfig.build.json && tailwindcss -i ./src/app.css -o ./dist/app.css --minify",
		"test": "node --test --test-reporter=dot --test-reporter-destination=stdout test/*.test.ts",
		"dev": "concurrently --names \"build,example\" --prefix-colors \"cyan,green\" \"tsc -p tsconfig.build.json --watch --preserveWatchOutput\" \"tailwindcss -i ./src/app.css -o ./dist/app.css --watch\" \"npm run dev --prefix example\"",
		"dev:tsc": "concurrently --names \"build\" --prefix-colors \"cyan\" \"tsc -p tsconfig.build.json --watch --preserveWatchOutput\" \"tailwindcss -i ./src/app.css -o ./dist/app.css --watch\"",
		"check": "biome check --write --error-on-warnings . && tsc --noEmit && cd example && biome check --write --error-on-warnings . && tsc --noEmit"
	},
	"dependencies": {
		"@lmstudio/sdk": "1.5.0",
		"@shuv1337/shuvpi-ai": "^0.84.2",
		"@shuv1337/shuvpi-tui": "^0.84.2",
		"typebox": "1.1.38",
		"docx-preview": "0.3.7",
		"jszip": "3.10.1",
		"lucide": "0.544.0",
		"ollama": "0.6.3",
		"pdfjs-dist": "5.4.394",
		"xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz"
	},
	"peerDependencies": {
		"@mariozechner/mini-lit": "^0.2.0",
		"lit": "^3.3.1"
	},
	"devDependencies": {
		"@mariozechner/mini-lit": "0.2.1",
		"@tailwindcss/cli": "4.3.0",
		"concurrently": "9.2.1",
		"typescript": "5.9.3"
	},
	"keywords": [
		"ai",
		"chat",
		"ui",
		"components",
		"llm",
		"web-components",
		"mini-lit"
	],
	"author": "Mario Zechner",
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/shuv1337/shuvpi.git",
		"directory": "packages/web-ui"
	}
}
