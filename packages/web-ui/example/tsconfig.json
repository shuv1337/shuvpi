{
	"compilerOptions": {
		"target": "ES2022",
		"module": "ESNext",
		"lib": [
			"ES2022",
			"DOM",
			"DOM.Iterable"
		],
		"moduleResolution": "bundler",
		"paths": {
			"*": [
				"./*"
			],
			"@shuv1337/shuvpi-telemetry": [
				"../../telemetry/src/index.ts"
			],
			"@shuv1337/shuvpi-telemetry/testing": [
				"../../telemetry/src/testing/index.ts"
			],
			"@shuv1337/shuvpi-agent-core": [
				"../../agent/src/index.ts"
			],
			"@shuv1337/shuvpi-ai": [
				"../../ai/src/index.ts"
			],
			"@shuv1337/shuvpi-tui": [
				"../../tui/src/index.ts"
			],
			"@shuv1337/shuvpi-web-ui": [
				"../src/index.ts"
			],
			"@shuv1337/shuvpi-ai/compat": [
				"../../ai/src/compat.ts"
			]
		},
		"strict": true,
		"skipLibCheck": true,
		"esModuleInterop": true,
		"allowSyntheticDefaultImports": true,
		"experimentalDecorators": true,
		"useDefineForClassFields": false,
		"allowImportingTsExtensions": true,
		"noEmit": true
	},
	"include": [
		"src/**/*"
	],
	"exclude": [
		"../src"
	]
}
