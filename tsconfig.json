{
	"extends": "./tsconfig.base.json",
	"compilerOptions": {
		"noEmit": true,
		"module": "NodeNext",
		"moduleResolution": "NodeNext",
		"paths": {
			"@shuv1337/shuvpi-chord": ["./packages/chord/src/index.ts"],
			"@shuv1337/shuvpi-chord/bundler": ["./packages/chord/src/bundler.ts"],
			"@shuv1337/shuvpi-chord/context": ["./packages/chord/src/context/index.ts"],
			"@shuv1337/shuvpi-chord/delta": ["./packages/chord/src/delta/index.ts"],
			"@shuv1337/shuvpi-chord/node": ["./packages/chord/src/node.ts"],
			"@shuv1337/shuvpi-telemetry": ["./packages/telemetry/src/index.ts"],
			"@shuv1337/shuvpi-telemetry/testing": ["./packages/telemetry/src/testing/index.ts"],
			"@shuv1337/shuvpi-codemode": ["./packages/codemode/src/index.ts"],
			"@shuv1337/shuvpi-codemode/declarations": ["./packages/codemode/src/declarations.ts"],
			"@shuv1337/shuvpi-codemode/source": ["./packages/codemode/src/source.ts"],
			"@shuv1337/shuvpi-codemode/worker": ["./packages/codemode/src/runtime/worker.ts"],
			"@shuv1337/shuvpi-mcp": ["./packages/mcp/src/index.ts"],
			"@shuv1337/shuvpi-mcp/oauth": ["./packages/mcp/src/oauth/index.ts"],
			"@shuv1337/shuvpi-mcp/testing": ["./packages/mcp/src/testing/index.ts"],
			"@shuv1337/shuvpi-ai": ["./packages/ai/src/index.ts"],
			"@shuv1337/shuvpi-ai/oauth": ["./packages/ai/src/oauth.ts"],
			"@shuv1337/shuvpi-ai/*": ["./packages/ai/src/*.ts", "./packages/ai/src/providers/*.ts"],
			"@shuv1337/shuvpi-ai/dist/*": ["./packages/ai/src/*"],
			"@shuv1337/shuvpi-durable": ["./packages/durable/src/index.ts"],
			"@shuv1337/shuvpi-durable/testing": ["./packages/durable/src/testing/index.ts"],
			"@shuv1337/shuvpi-durable/*": [
				"./packages/durable/src/*.ts",
				"./packages/durable/src/*/index.ts",
				"./packages/durable/src/*"
			],
			"@shuv1337/shuvpi-agent-core": ["./packages/agent/src/index.ts"],
			"@shuv1337/shuvpi-coding-agent": ["./packages/coding-agent/src/index.ts"],
			"@shuv1337/shuvpi-coding-agent/experimental/plugin": [
				"./packages/coding-agent/src/experimental/plugin.ts"
			],
			"@shuv1337/shuvpi-coding-agent/hooks": ["./packages/coding-agent/src/core/hooks/index.ts"],
			"@shuv1337/shuvpi-coding-agent/*": ["./packages/coding-agent/src/*"],
			"@shuv1337/shuvpi-protocol": ["./packages/protocol/src/index.ts"],
			"@shuv1337/shuvpi-protocol/*": ["./packages/protocol/src/*"],
			"@shuv1337/shuvpi-client": ["./packages/client/src/index.ts"],
			"@shuv1337/shuvpi-client/unix": ["./packages/client/src/unix.ts"],
			"@shuv1337/shuvpi-client/*": ["./packages/client/src/*"],
			"@shuv1337/shuvpi-server": ["./packages/server/src/index.ts"],
			"@shuv1337/shuvpi-server/unix": ["./packages/server/src/transports/unix/index.ts"],
			"@shuv1337/shuvpi-server/*": ["./packages/server/src/*"],
			"typebox": ["./node_modules/typebox"],
			"@shuv1337/shuvpi-tui": ["./packages/tui/src/index.ts"],
			"@shuv1337/shuvpi-tui/*": ["./packages/tui/src/*"],
			"@earendil-works/pi-agent-old": ["./packages/agent-old/src/index.ts"],
			"@earendil-works/pi-agent-old/*": ["./packages/agent-old/src/*"]
		}
	},
	"include": ["scripts/model-catalog-protocol.ts", "scripts/model-catalog-protocol.test.ts", "packages/*/src/**/*", "packages/*/test/**/*", "packages/coding-agent/examples/**/*", "packages/agent/examples/**/*"],
	"exclude": ["**/dist/**", "packages/coding-agent/examples/extensions/gondolin/**"]
}
